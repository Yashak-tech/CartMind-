# Razorpay Test Mode Credentials (NEVER use live keys)
# Get your test keys from Razorpay Dashboard -> Settings -> API Keys (in Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Groq API Key (for LLM reasoning layer in Phase 3)
GROQ_API_KEY=gsk_YourGroqApiKeyHere

# Application Configuration
ENVIRONMENT=development
PORT=8000
BASE_URL=http://localhost:8000
BACKEND_URL=https://your-cartmind-backend.onrender.com

# Production CORS Origins (Explicitly allows your Vercel frontend)
FRONTEND_URL=https://your-cartmind-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-cartmind-frontend.vercel.app

# Access Gate Authentication & Resend Email Provider
JWT_SECRET=your_jwt_signing_secret_here
RESEND_API_KEY=re_YourResendApiKeyHere
RESEND_FROM_EMAIL=CartMind Access <onboarding@resend.dev>
